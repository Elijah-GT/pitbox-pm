<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>MESA ARC Racing</Author>
    <Description>Starts the CarHub server at boot and restarts it if it dies. Logs to deploy\logs\pitbox.log.</Description>
    <URI>\CarHub Server</URI>
  </RegistrationInfo>

  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <!-- Let the network stack settle before binding. -->
      <Delay>PT30S</Delay>
    </BootTrigger>
  </Triggers>

  <Principals>
    <!-- SYSTEM, so the server comes back after a reboot with nobody logged in.
         This is why installing this task needs an elevated PowerShell. -->
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <!-- A server should never be killed for running too long. PT0S = no limit. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>10</Count>
    </RestartOnFailure>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>{{PYTHON}}</Command>
      <Arguments>"{{PROJECT_DIR}}\deploy\serve.py"</Arguments>
      <WorkingDirectory>{{PROJECT_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
