# Copy to .env and edit. Everything has a sane default; you can run with no .env at all.
PITBOX_DATABASE_URL=sqlite:///./pitbox.db
PITBOX_STORAGE_DIR=./storage
PITBOX_MAX_UPLOAD_MB=100
PITBOX_TEAM_NAME=MESA ARC Racing

# How access is controlled. Defaults to cloudflare, so a careless deploy fails
# closed rather than open.
#   cloudflare - Cloudflare Access decides. The app verifies the JWT Cloudflare
#                signs, so a forged header is worthless. Needs the two
#                PITBOX_ACCESS_* values below and will not start without them.
#   password   - the built-in login (scrypt + sessions), for running without
#                Cloudflare. Create accounts with scripts/create_user.py.
#   none       - wide open. Local development only; dev.ps1 sets this.
PITBOX_AUTH_MODE=cloudflare

# --- Cloudflare Access (required when PITBOX_AUTH_MODE=cloudflare) ---
# Your Zero Trust team domain. `yourteam` alone is expanded to
# yourteam.cloudflareaccess.com; a full URL works too.
PITBOX_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Application Audience (AUD) tag, 64 hex characters, from the Access
# application's Overview tab. This is what ties a token to THIS app -- without
# it, a token minted for any other app on your Cloudflare team would be accepted.
PITBOX_ACCESS_AUD=

# --- host allowlist (optional) ---
# Comma-separated hostnames the app will answer on; empty means any. Worth
# setting on a host that hands out a public URL you did not ask for, so that URL
# is refused outright. See docs/FLY.md.
PITBOX_ALLOWED_HOSTS=

# Set true once you are behind HTTPS (password mode only).
PITBOX_COOKIE_SECURE=false
